{
  "manifest_version": 3,
  "name": "Macragge's Honour Download Interceptor Scanner",
  "version": "1.0",
  "description": "Intercepts all browser downloads and warns the user before downloading.",
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "permissions": [
    "downloads",
    "storage",
    "tabs",
    "scripting",
    "search",
    "bookmarks"
  ],
  "host_permissions": [
    "https://outlook.live.com/*",
    "https://mail.google.com/*",
    "https://mail.proton.me/*",
    "https://www.virustotal.com/*"
  ],
  "background": {
    "scripts": [ "background.js" ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://outlook.live.com/*",
        "https://mail.google.com/*",
        "https://mail.proton.me/*"
      ],
      "js": [ "content.js" ]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "Icons/Icon16.png",
      "48": "Icons/Icon48.png",
      "128": "Icons/Icon128.png"
    }
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "framework/*",
        "content/*"
      ],
      "matches": [ "<all_urls>" ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "strict_min_version": "109.0"
    }
  }
}